use_frameworks!

target "TennisApp" do

	#Crashlytics
	pod 'Fabric', '~> 1.5'
	pod 'Crashlytics'

	#Mobile Database
	pod 'RealmSwift', '~> 0.98'

	#ReatciveCocoa    
	pod 'ReactiveCocoa', '~> 4.0'

	#Menu
	pod 'RESideMenu', '~> 4.0.7'

	#Networking
	pod 'AlamofireImage', '~> 2.0'
	pod 'Alamofire', '~> 3.1'

	#Form
	pod 'Eureka', '~> 1.3'

	#UI
	pod 'FontAwesome.swift', '~> 0.6'
	pod 'DZNEmptyDataSet'
	pod 'FormatterKit'
	pod 'MBProgressHUD', '~> 0.8'
	pod 'IQKeyboardManager', '~> 3.3'
	pod 'SWTableViewCell', '~> 0.3'
    
	#Charts
	pod 'Charts', '~> 2.1'
    
	#PagedView
	pod 'PagingMenuController'
    
	#Pull to refresh for tablew view and collection view
	pod 'INSPullToRefresh', '~> 1.0'

