EMBEDDED_CONTENT_CONTAINS_SWIFT = YES
FRAMEWORK_SEARCH_PATHS = $(inherited) "$CONFIGURATION_BUILD_DIR/ALCameraViewController" "$CONFIGURATION_BUILD_DIR/Alamofire" "$CONFIGURATION_BUILD_DIR/AlamofireImage" "$CONFIGURATION_BUILD_DIR/Charts" "$CONFIGURATION_BUILD_DIR/DZNEmptyDataSet" "$CONFIGURATION_BUILD_DIR/Eureka" "$CONFIGURATION_BUILD_DIR/FontAwesome.swift" "$CONFIGURATION_BUILD_DIR/FormatterKit" "$CONFIGURATION_BUILD_DIR/GSKStretchyHeaderView" "$CONFIGURATION_BUILD_DIR/INSPullToRefresh" "$CONFIGURATION_BUILD_DIR/IQKeyboardManagerSwift" "$CONFIGURATION_BUILD_DIR/MBProgressHUD" "$CONFIGURATION_BUILD_DIR/PagingMenuController" "$CONFIGURATION_BUILD_DIR/RESideMenu" "$CONFIGURATION_BUILD_DIR/ReactiveCocoa" "$CONFIGURATION_BUILD_DIR/Realm" "$CONFIGURATION_BUILD_DIR/RealmSwift" "$CONFIGURATION_BUILD_DIR/Result" "$CONFIGURATION_BUILD_DIR/SWTableViewCell" "${PODS_ROOT}/Crashlytics/iOS" "${PODS_ROOT}/Fabric/iOS"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_ROOT}/Headers/Public" "${PODS_ROOT}/Headers/Public/Crashlytics" "${PODS_ROOT}/Headers/Public/Fabric"
LD_RUNPATH_SEARCH_PATHS = $(inherited) '@executable_path/Frameworks' '@loader_path/Frameworks'
OTHER_CFLAGS = $(inherited) -iquote "$CONFIGURATION_BUILD_DIR/ALCameraViewController/ALCameraViewController.framework/Headers" -iquote "$CONFIGURATION_BUILD_DIR/Alamofire/Alamofire.framework/Headers" -iquote "$CONFIGURATION_BUILD_DIR/AlamofireImage/AlamofireImage.framework/Headers" -iquote "$CONFIGURATION_BUILD_DIR/Charts/Charts.framework/Headers" -iquote "$CONFIGURATION_BUILD_DIR/DZNEmptyDataSet/DZNEmptyDataSet.framework/Headers" -iquote "$CONFIGURATION_BUILD_DIR/Eureka/Eureka.framework/Headers" -iquote "$CONFIGURATION_BUILD_DIR/FontAwesome.swift/FontAwesome_swift.framework/Headers" -iquote "$CONFIGURATION_BUILD_DIR/FormatterKit/FormatterKit.framework/Headers" -iquote "$CONFIGURATION_BUILD_DIR/GSKStretchyHeaderView/GSKStretchyHeaderView.framework/Headers" -iquote "$CONFIGURATION_BUILD_DIR/INSPullToRefresh/INSPullToRefresh.framework/Headers" -iquote "$CONFIGURATION_BUILD_DIR/IQKeyboardManagerSwift/IQKeyboardManagerSwift.framework/Headers" -iquote "$CONFIGURATION_BUILD_DIR/MBProgressHUD/MBProgressHUD.framework/Headers" -iquote "$CONFIGURATION_BUILD_DIR/PagingMenuController/PagingMenuController.framework/Headers" -iquote "$CONFIGURATION_BUILD_DIR/RESideMenu/RESideMenu.framework/Headers" -iquote "$CONFIGURATION_BUILD_DIR/ReactiveCocoa/ReactiveCocoa.framework/Headers" -iquote "$CONFIGURATION_BUILD_DIR/Realm/Realm.framework/Headers" -iquote "$CONFIGURATION_BUILD_DIR/RealmSwift/RealmSwift.framework/Headers" -iquote "$CONFIGURATION_BUILD_DIR/Result/Result.framework/Headers" -iquote "$CONFIGURATION_BUILD_DIR/SWTableViewCell/SWTableViewCell.framework/Headers" -isystem "${PODS_ROOT}/Headers/Public" -isystem "${PODS_ROOT}/Headers/Public/Crashlytics" -isystem "${PODS_ROOT}/Headers/Public/Fabric"
OTHER_LDFLAGS = $(inherited) -ObjC -l"c++" -l"z" -framework "ALCameraViewController" -framework "Alamofire" -framework "AlamofireImage" -framework "Charts" -framework "Crashlytics" -framework "DZNEmptyDataSet" -framework "Eureka" -framework "Fabric" -framework "FontAwesome_swift" -framework "FormatterKit" -framework "GSKStretchyHeaderView" -framework "INSPullToRefresh" -framework "IQKeyboardManagerSwift" -framework "MBProgressHUD" -framework "PagingMenuController" -framework "RESideMenu" -framework "ReactiveCocoa" -framework "Realm" -framework "RealmSwift" -framework "Result" -framework "SWTableViewCell" -framework "Security" -framework "SystemConfiguration" -framework "UIKit"
OTHER_SWIFT_FLAGS = $(inherited) "-D" "COCOAPODS"
PODS_ROOT = ${SRCROOT}/Pods
